# Work deployment:   docker compose --env-file work.env up --build -d
#
# The locations below are PLACEHOLDERS on avro.com: replace them on the work
# machine with the site's real image registry prefix, apt mirror, npm registry
# and proxy - and never commit those values. No secrets in this file. Every key
# must stay present; an empty value means "off".

# --- where the build downloads from -------------------------------------------
IMAGE_REGISTRY=registry.avro.com/
APT_MIRROR=http://ubuntu-mirror.avro.com/ubuntu
NPM_REGISTRY=https://npm-mirror.avro.com/
HTTP_PROXY=http://proxy.avro.com:8080
HTTPS_PROXY=http://proxy.avro.com:8080
NO_PROXY=localhost,127.0.0.1,avro.com
# The running app reaches out only for Microsoft sign-in.
RUNTIME_HTTPS_PROXY=http://proxy.avro.com:8080

# --- demo mode ------------------------------------------------------------------
# true:  made-up people, teams, gifts and tasks to click around in. Every sign-in
#        code is SANTA_DEMO_OTP, admin / admin works, no email ever leaves the app.
#        Demo data lives in its own database file (demo.sqlite).
# false: real data only (santa.sqlite). No demo record is visible - the demo file
#        is simply not opened. Flip it and run the same command again.
SANTA_DEMO_MODE=true
SANTA_DEMO_OTP=123456

# --- how people reach it ------------------------------------------------------------
# Host networking: the app listens on this port on the host itself. An HTTPS
# address is needed for Microsoft sign-in (Azure accepts plain http only for
# localhost).
SANTA_PORT=8443
SANTA_BIND=0.0.0.0
SANTA_BASE_URL=https://santa.avro.com:8443
# HTTPS: drop the real certificate and key into SANTA_TLS_DIR as tls.crt and
# tls.key (PEM). Until then a self-signed pair is made there on the first start.
SANTA_TLS_SELF_SIGNED=true
SANTA_TLS_HOSTNAME=santa.avro.com
# true only when a reverse proxy on this host forwards to the app.
SANTA_TRUST_PROXY=false
TZ=UTC

# --- Microsoft (Azure Entra ID) sign-in -------------------------------------------
# Empty = off. The client secret goes ALONE in SANTA_SECRETS_DIR/azure_client_secret.
SANTA_AZURE_TENANT_ID=
SANTA_AZURE_CLIENT_ID=

# --- where the data lives -----------------------------------------------------------
# Outside the code folder on purpose: copying a newer version of the project over
# this folder must never touch the database. Create them once, as yourself:
#   mkdir -p ../secret-santa-state/data ../secret-santa-state/tls ../secret-santa-state/secrets
SANTA_DATA_DIR=../secret-santa-state/data
SANTA_TLS_DIR=../secret-santa-state/tls
SANTA_SECRETS_DIR=../secret-santa-state/secrets
