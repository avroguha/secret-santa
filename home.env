# Home lab:   docker compose --env-file home.env up --build -d
#
# Public registries, no proxy. The empty lines must stay: an empty value means
# "off", a missing key stops compose. No secrets in this file.

# --- where the build downloads from -------------------------------------------
IMAGE_REGISTRY=
APT_MIRROR=
NPM_REGISTRY=https://registry.npmjs.org/
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
RUNTIME_HTTPS_PROXY=

# --- demo mode ------------------------------------------------------------------
# true = made-up data, every sign-in code is SANTA_DEMO_OTP, nothing is emailed.
# false = real data only (a separate database; no demo record is ever shown).
SANTA_DEMO_MODE=true
SANTA_DEMO_OTP=123456

# --- how people reach it ------------------------------------------------------------
SANTA_PORT=8080
SANTA_BIND=0.0.0.0
# the address people type (used in email links) - an example home-lab host; set your own.
SANTA_BASE_URL=http://192.168.5.113:8080
SANTA_TLS_SELF_SIGNED=false
SANTA_TLS_HOSTNAME=
SANTA_TRUST_PROXY=false
TZ=Asia/Kolkata

# --- Microsoft (Azure Entra ID) sign-in -------------------------------------------
SANTA_AZURE_TENANT_ID=
SANTA_AZURE_CLIENT_ID=

# --- where the data lives -----------------------------------------------------------
SANTA_DATA_DIR=./data
SANTA_TLS_DIR=./tls
SANTA_SECRETS_DIR=./secrets
